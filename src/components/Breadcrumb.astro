---
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---

<nav class="bc" aria-label="面包屑">
  <ol>
    {items.map((item, idx) => (
      <li class="bc__item">
        {item.href && idx < items.length - 1
          ? <a href={item.href}>{item.label}</a>
          : <span aria-current="page">{item.label}</span>}
        {idx < items.length - 1 && <span class="bc__sep" aria-hidden="true">›</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .bc ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    font: var(--nz-font-caption);
    color: var(--nz-text-secondary);
  }
  .bc__item { display: inline-flex; align-items: center; gap: 6px; }
  .bc a {
    color: var(--nz-text-secondary);
    padding: 2px 6px;
    margin: -2px -6px;
    border-radius: var(--nz-radius-small);
    transition: background var(--nz-duration-faster) var(--nz-easing-max), color var(--nz-duration-faster) var(--nz-easing-max);
  }
  .bc a:hover { background: var(--nz-subtle-secondary); color: var(--nz-text-primary); }
  .bc__sep { color: var(--nz-text-tertiary); }
  .bc__item:last-child span { color: var(--nz-text-primary); font-weight: 600; }
</style>
