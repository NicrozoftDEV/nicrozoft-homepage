---
import Badge from './Badge.astro';
import { machineTags, type Machine } from '../lib/mcMachines';

interface Props {
  machines: Machine[];
}

const { machines } = Astro.props;

const tagOf = (id: string) => machineTags[id];
---

<ul class="mlist">
  {machines.map((m) => (
    <li class="mlist__item">
      <p class="mlist__name">{m.name}</p>
      <div class="mlist__tags">
        {m.tags.map((t) => {
          const def = tagOf(t);
          return def ? (
            <span class="mlist__tag" title={def.hint}>
              <Badge tone={def.tone} subtle><span class="mlist__tag-icon" aria-hidden="true">{def.icon}</span>{def.label}</Badge>
            </span>
          ) : null;
        })}
      </div>
    </li>
  ))}
</ul>

<style>
  .mlist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--nz-space-2);
  }
  .mlist__item {
    padding: var(--nz-space-3) var(--nz-space-4);
    border-radius: var(--nz-radius-medium);
    background: var(--nz-subtle-secondary);
    border: 1px solid var(--nz-stroke-default);
    display: flex;
    flex-direction: column;
    gap: var(--nz-space-2);
  }
  .mlist__name {
    font: var(--nz-font-body-strong);
    color: var(--nz-text-primary);
  }
  .mlist__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--nz-space-2);
  }
  .mlist__tag-icon {
    margin-right: 5px;
    font-style: normal;
  }
</style>
