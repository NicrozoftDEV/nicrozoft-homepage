---
import MachineTag from './MachineTag.astro';
import type { Machine } from '../lib/mcMachines';

interface Props {
  machines: Machine[];
}

const { machines } = Astro.props;
---

<ul class="mlist">
  {machines.map((m) => <li class="mlist__item">
    <p class="mlist__name">{m.name}</p>
    <div class="mlist__tags">
      {m.tags.map((tag) => (
        <MachineTag tag={tag} />
      ))}
    </div>
  </li>)}
</ul>

<style>
  .mlist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--nz-space-2);
  }
  .mlist__item {
    padding: var(--nz-space-3) var(--nz-space-4);
    border-radius: var(--nz-radius-medium);
    background: var(--nz-subtle-secondary);
    border: 1px solid var(--nz-stroke-default);
    display: flex;
    flex-direction: column;
    gap: var(--nz-space-2);
  }
  .mlist__name {
    font: var(--nz-font-body-strong);
    color: var(--nz-text-primary);
  }
  .mlist__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--nz-space-2);
  }
</style>
