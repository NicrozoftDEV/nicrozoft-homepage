---
import Icon from 'fluentui-astro-icons';
import Badge from './Badge.astro';
import { machineTags, type MachineTagId, type MachineTagDef } from '../lib/mcMachines';

interface Props {
  tag: MachineTagId;
}
const { tag } = Astro.props;
const definition: MachineTagDef = machineTags[tag];
---

<span title={definition.hint}>
  <Badge tone={definition.tone} subtle
    ><Icon name={definition.icon} variant="filled" size={14} />{definition.label}</Badge
  >
</span>
