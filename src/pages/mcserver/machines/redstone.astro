---
import McWikiLayout from '../../../layouts/McWikiLayout.astro';
import MachineList from '../../../components/MachineList.astro';
import { machineCategories } from '../../../lib/mcMachines';

const cat = machineCategories.find((c) => c.id === 'redstone')!;
---

<McWikiLayout title="普通红石机器类" lead="全物品系统、红石电路等常规红石机器。共 8 台。">
  <article class="nz-acrylic mcw-card">
    <h2 class="mcw-h2">普通红石机器类</h2>
    <MachineList machines={cat.machines} />
    <p class="mcw-p">各机器的详细信息（原理、产出、位置等）将后续补充。</p>
  </article>
</McWikiLayout>
