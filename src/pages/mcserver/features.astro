---
import McWikiLayout from '../../layouts/McWikiLayout.astro';
import Badge from '../../components/Badge.astro';

const pages = [
  {
    href: '/mcserver/features/technical',
    title: '生电与技术规则',
    desc: '服务端开启的生电向规则：更新抑制、可再生资源、生物与战斗、交互便利等。',
  },
  {
    href: '/mcserver/features/fakeplayer',
    title: '假人系统',
    desc: 'Leaves 内置假人（/bot）系统、Carpet 风格 /player 命令与本地分支增强。',
  },
  {
    href: '/mcserver/features/protocol',
    title: '客户端协议兼容',
    desc: '投影、Servux、Jade、小地图等客户端模组与服务端的协议兼容支持。',
  },
  {
    href: '/mcserver/features/plugins',
    title: '插件特性',
    desc: '插件提供的玩法与功能：登录验证、跨版本加入、伪装、领地、新配方等。',
  },
  {
    href: '/mcserver/features/performance',
    title: '性能与修复',
    desc: '服务端性能优化与原版漏洞修复，多数对玩家无直接感知。',
  },
];
---

<McWikiLayout title="特性" lead="服务端为自行维护的 Leaves 分支（基于 Paper），以下特性为服务器当前实际配置，未启用的规则不会列出。">
  <article class="nz-acrylic mcw-card">
    <h2 class="mcw-h2">关于标注</h2>
    <p class="mcw-p">
      带 <Badge tone="success" subtle>本地分支</Badge> 标记的规则为本地 Leaves 分支新增或重制的功能，其他 Leaves 服务器通常没有；
      带 <Badge tone="caution" subtle>本地扩展</Badge> 标记的规则来自上游，但本地分支为其追加了新功能或特性；
      带 <Badge tone="critical" subtle>仅管理员或授权用户</Badge> 标记的功能仅限管理员或经授权的玩家使用。
      未标记的规则来自上游 Leaves / Paper。
    </p>
  </article>

  <nav class="mcw__cats" aria-label="特性分类">
    {pages.map((p) => (
      <a class="mcw__cat-card nz-lift" href={p.href}>
        <span class="mcw__cat-title">{p.title}</span>
        <span class="mcw__cat-desc">{p.desc}</span>
      </a>
    ))}
  </nav>
</McWikiLayout>

<style>
  .mcw__cats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--nz-space-3);
  }
  .mcw__cat-card {
    display: flex;
    flex-direction: column;
    gap: var(--nz-space-2);
    padding: var(--nz-space-5);
    border-radius: var(--nz-radius-large);
    background: var(--nz-subtle-secondary);
    border: 1px solid var(--nz-stroke-card);
    text-decoration: none;
    transition:
      background var(--nz-duration-faster) var(--nz-easing-max),
      border-color var(--nz-duration-faster) var(--nz-easing-max);
  }
  .mcw__cat-card:hover {
    background: var(--nz-subtle-tertiary);
    border-color: color-mix(in srgb, var(--nz-accent-default) 40%, transparent);
  }
  .mcw__cat-title {
    font: var(--nz-font-subtitle);
    color: var(--nz-text-primary);
  }
  .mcw__cat-title::after { content: " →"; color: var(--nz-accent-text); }
  .mcw__cat-desc {
    font: var(--nz-font-body);
    color: var(--nz-text-secondary);
  }
</style>
