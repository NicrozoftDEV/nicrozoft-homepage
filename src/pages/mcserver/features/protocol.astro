---
import McWikiLayout from '../../../layouts/McWikiLayout.astro';
import WikiRules from '../../../components/WikiRules.astro';
import type { WikiRuleGroup } from '../../../components/WikiRules.astro';

const groups: WikiRuleGroup[] = [
  {
    title: '投影与建造',
    rules: [
      {
        key: 'protocol.servux.litematics',
        value: '上限 500 KB',
        desc: '<a href="https://github.com/maruohon/servux" target="_blank" rel="noopener noreferrer">Servux</a> 投影协议：Litematica 投影的上传、下载与服务端粘贴，单次 NBT 上限 500 KB。',
      },
      {
        key: 'protocol.syncmatica',
        desc: '<a href="https://github.com/altrisi/syncmatica" target="_blank" rel="noopener noreferrer">Syncmatica</a> 协议：在服务器上与其他玩家共享投影，协同建造。',
      },
      {
        key: 'protocol.alternative-block-placement',
        value: 'LITEMATICA',
        desc: '服务端支持 Litematica 的轻松放置（Easy Place）协议，无需作弊模式即可使用轻松放置。',
      },
      {
        key: 'protocol.servux.structure-protocol',
        desc: 'Servux 结构协议：向客户端提供结构边界框等结构数据。',
      },
      {
        key: 'protocol.jade-protocol',
        desc: '<a href="https://github.com/Snownee/Jade" target="_blank" rel="noopener noreferrer">Jade</a> 协议：同步方块与实体信息，供 Jade（WAILA 系）前端显示。',
      },
    ],
  },
  {
    title: '数据同步',
    rules: [
      {
        key: 'protocol.servux.entity-protocol',
        desc: 'Servux 实体协议：向客户端同步实体详细数据（<a href="https://github.com/maruohon/minihud" target="_blank" rel="noopener noreferrer">MiniHUD</a> 等）。',
      },
      {
        key: 'protocol.servux.hud-logger-protocol',
        value: 'TPS · MOB_CAPS',
        desc: 'Servux HUD 数据记录器：向客户端同步 TPS 与生物上限数据，每秒更新一次。',
      },
      {
        key: 'protocol.servux.hud-metadata-protocol-share-seed',
        desc: 'HUD 元数据共享包含世界种子（服务器种子本就公开，见<a href="/mcserver/rules">服务器游玩规定</a>）。',
      },
      {
        key: 'protocol.appleskin',
        desc: '<a href="https://github.com/squeek502/AppleSkin" target="_blank" rel="noopener noreferrer">AppleSkin</a> 协议：同步饱食度等数据，使 AppleSkin 显示准确。',
      },
      {
        key: 'protocol.xaero-map-protocol',
        desc: '<a href="https://modrinth.com/mod/xaeros-minimap" target="_blank" rel="noopener noreferrer">Xaero’s 小地图</a>协议：向客户端同步世界信息，地图数据跨会话一致。',
      },
      {
        key: 'protocol.rei-server-protocol',
        desc: '<a href="https://github.com/shedaniel/RoughlyEnoughItems" target="_blank" rel="noopener noreferrer">REI</a> 服务端协议：同步合成、烧炼等配方数据。',
      },
    ],
  },
  {
    title: '其他协议',
    rules: [
      {
        key: 'protocol.bladeren.mspt-sync-protocol',
        value: '每 20 tick',
        desc: 'Bladeren MSPT 同步协议：向客户端同步服务器 MSPT，供 Bladeren 等模组显示。',
      },
      {
        key: 'protocol.chat-image-protocol',
        desc: '聊天图片协议：支持在聊天中发送与显示图片。',
      },
      {
        key: 'protocol.leaves-carpet-support',
        desc: '向 Carpet 系客户端同步服务端规则状态（如 creativeNoClip），使客户端行为与服务端一致。',
      },
      {
        key: 'protocol.pca · protocol.bbor-protocol',
        value: '未启用',
        desc: 'PCA 同步协议与 BBOR 协议当前未启用。',
      },
    ],
  },
];
---

<McWikiLayout
  title="客户端协议兼容"
  lead="服务端原生支持多种客户端模组协议，安装对应模组即可获得增强体验；未安装任何模组也完全不影响正常游玩。"
>
  <article class="nz-acrylic mcw-card">
    <h2 class="mcw-h2">本地分支的 Servux 修复</h2>
    <p class="mcw-p">
      本地分支重写了 Servux 兼容层：修复了握手竞态与协议标识校验问题，并按客户端版本区分两代线格式——
      新版（<a href="https://github.com/maruohon/litematica" target="_blank" rel="noopener noreferrer">Litematica</a> ≥ 0.28.5 / <a href="https://github.com/maruohon/malilib" target="_blank" rel="noopener noreferrer">malilib</a> 系）与旧版客户端的投影粘贴、实体数据、结构边界框均可正常工作。
    </p>
  </article>

  <WikiRules groups={groups} />
</McWikiLayout>
