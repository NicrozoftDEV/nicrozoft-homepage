---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
// Group rules — transcribed from grouprule.png (reconciled with the v12.0 docx)
// and rendered server-side instead of shipping the image.
import { Content as GroupRules } from '../data/group-rules.md';
---

<BaseLayout title="交流群" description="Nicrozoft 产品测试及交流群。">
  <Hero
    eyebrow="交流群"
    title="Nicrozoft 产品测试及交流群"
    subtitle="发表你对 Nicrozoft 产品的看法和建议，帮助测试 Nicrozoft 产品，或者交流和计算机有关的内容。"
    variant="compact"
  />

  <section class="nz-section nz-container nz-stack nz-stack--lg">
    <div class="nz-acrylic group__panel">
      <p class="nz-body-large">
        你可以加入 Nicrozoft 产品测试及交流群来发表你对 Nicrozoft 产品的看法和建议，帮助测试 Nicrozoft 产品，或者交流和计算机有关的内容。
      </p>
      <div class="group__actions">
        <Button href="https://qm.qq.com/q/Kj9xQNIFOe" target="_blank" variant="accent" size="lg">
          加入 Nicrozoft 产品测试及交流群（QQ）
        </Button>
      </div>
    </div>

    <article class="nz-acrylic group__rules">
      <h2 class="nz-subtitle group__rules-title">群规</h2>
      <div class="nz-prose">
        <GroupRules />
      </div>
    </article>
  </section>
</BaseLayout>

<style>
  .group__panel {
    padding: var(--nz-space-8);
    display: flex;
    flex-direction: column;
    gap: var(--nz-space-5);
  }
  .group__actions { display: flex; gap: var(--nz-space-3); flex-wrap: wrap; }

  .group__rules { padding: var(--nz-space-8); }
  .group__rules-title { margin-bottom: var(--nz-space-4); }
  /* Tighten the dense rules list a touch */
  .group__rules :global(.nz-prose ol) { display: flex; flex-direction: column; gap: var(--nz-space-3); }
  .group__rules :global(.nz-prose li) { line-height: 1.75; }
</style>
