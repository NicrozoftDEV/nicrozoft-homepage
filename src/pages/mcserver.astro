---
import McWikiLayout from '../layouts/McWikiLayout.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import { mcWikiNav } from '../lib/mcWiki';

// Section cards on the landing page: everything except the intro itself.
const sections = mcWikiNav.filter((s) => s.href !== '/mcserver');
const sectionDesc: Record<string, string> = {
  群组: '加入交流群与申请白名单',
  加入方式: '直连 / 虚拟局域网 / 内网穿透',
  玩法: '生电、建筑与特色玩法',
  特性: '服务端规则、协议兼容与插件',
  机器: '服务器内的机器收录',
  规定: '游玩规定与违规封禁措施',
};
---

<McWikiLayout
  title="简介"
  lead="基于 Minecraft Java 26.2 的生存服务器，服务端为自行维护的 Leaves 分支，理论支持 Java 版 1.7.10 ~ 26.3，及基岩版 26.30 ~ 26.51 加入。"
>
  <article class="nz-acrylic mcw-card">
    <header class="mcw__head-badges">
      <Badge tone="active" icon="●">已开服一年有余</Badge>
      <Badge tone="series">Leaves 分支 · Java 26.2</Badge>
    </header>
    <h2 class="mcw-h2">简介</h2>
    <p>
      服务器主要玩法为生电和建筑，目前处于生电中期，已建造编码全物品、刷铁机、堆门猪人塔、三联试炼农场、空置域刷怪塔等机器，实现部分资源的量产。
      目前也有富人刷冰机、二联神殿农场、百万溺尸塔等机器正在建设中。欢迎生电玩家前来帮助，也欢迎建筑玩家来建造独属于你的建筑！
    </p>
    <p>
      服务器为半正版服，正版玩家加入服务器可以自动登录，离线玩家需要设置密码，后续进服需要进行密码验证。
      非正版玩家(离线或 LittleSkin)如果和正版玩家重名则无法进服，需检查是否与正版用户名重复，如重复，需修改自己用户名。
      服务器采用白名单制，进群后需要报告自己的 Minecraft 用户名以加入白名单。
    </p>
    <p>
      加入白名单后，正版玩家可直接进服游玩；为防止使用同用户名盗号，离线玩家第一次进服需要设置密码，后续进服需要验证密码。
      如后续转为同名正版账户，可执行 <code>/premium</code> 以切换到正版进服，不再需要验证密码。
      如果更改用户名，需要联系服主 Nicrozoft 以进行玩家数据迁移。
    </p>
    <p><span class="warn">本服务器不欢迎故意破坏公共设施的玩家加入。如果你存在这类倾向，请移步无规则服务器。</span></p>

    <div class="mcw-actions">
      <Button href="/mcserver/group" variant="accent" size="lg">前往群组页</Button>
      <Button href="/mcserver/join" size="lg">查看加入方式</Button>
    </div>
  </article>

  <nav class="mcw__quick" aria-label="Wiki 目录">
    {sections.map((s) => (
      <a class="mcw__quick-card nz-lift" href={s.href ?? s.items?.[0].href}>
        <span class="mcw__quick-title">{s.label}</span>
        <span class="mcw__quick-desc">{sectionDesc[s.label]}</span>
      </a>
    ))}
  </nav>
</McWikiLayout>

<style>
  .mcw__head-badges {
    display: flex;
    gap: var(--nz-space-2);
    flex-wrap: wrap;
    margin-bottom: var(--nz-space-2);
  }
  .mcw__quick {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--nz-space-3);
  }
  .mcw__quick-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--nz-space-4) var(--nz-space-5);
    border-radius: var(--nz-radius-large);
    background: var(--nz-subtle-secondary);
    border: 1px solid var(--nz-stroke-card);
    text-decoration: none;
    transition:
      background var(--nz-duration-faster) var(--nz-easing-max),
      border-color var(--nz-duration-faster) var(--nz-easing-max);
  }
  .mcw__quick-card:hover {
    background: var(--nz-subtle-tertiary);
    border-color: color-mix(in srgb, var(--nz-accent-default) 40%, transparent);
  }
  .mcw__quick-title {
    font: var(--nz-font-body-strong);
    color: var(--nz-text-primary);
  }
  .mcw__quick-title::after { content: " →"; color: var(--nz-accent-text); }
  .mcw__quick-desc {
    font: var(--nz-font-caption);
    color: var(--nz-text-tertiary);
  }
</style>
