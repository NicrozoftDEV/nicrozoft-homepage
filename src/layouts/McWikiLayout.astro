---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import McWikiNav from '../components/McWikiNav.astro';
import type { McWikiSection } from '../lib/mcWiki';

interface Props {
  title: string;
  navigation: McWikiSection[];
  description?: string;
  /** One-line lead shown under the page title. */
  lead?: string;
}

const { title, description, lead, navigation } = Astro.props;
---

<BaseLayout title={title} description={description ?? 'Nicrozoft 的 Minecraft 生存服务器 Wiki。'}>
  <div class="mcw nz-container">
    <Breadcrumb
      items={[{ label: '主页', href: '/' }, { label: 'Minecraft 服务器', href: '/mcserver' }, { label: title }]}
    />

    <div class="mcw__row">
      <!-- Mobile nav: collapsible page menu (hidden on desktop) -->
      <details class="mcw__toc-m">
        <summary>页面导航</summary>
        <McWikiNav sections={navigation} />
      </details>

      <!-- Desktop sidebar -->
      <aside class="mcw__side">
        <McWikiNav title="Nicrozoft 服务器 Wiki" sections={navigation} />
      </aside>

      <div class="mcw__main">
        <header class="mcw__head">
          <h1 class="mcw__title nz-gradient-text">{title}</h1>
          {lead && <p class="mcw__lead">{lead}</p>}
        </header>

        <div class="mcw__body">
          <slot />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .mcw {
    display: flex;
    flex-direction: column;
    gap: var(--nz-space-5);
    padding-block: var(--nz-space-10) var(--nz-space-12);
  }
  .mcw__row {
    display: grid;
    grid-template-columns: 216px minmax(0, 1fr);
    gap: var(--nz-space-8);
    align-items: start;
  }
  @media (max-width: 920px) {
    .mcw {
      padding-top: var(--nz-space-6);
      gap: var(--nz-space-4);
    }
    .mcw__row {
      grid-template-columns: 1fr;
    }
  }

  /* ---- Sidebar (desktop) ---- */
  .mcw__side {
    position: sticky;
    top: 84px;
    display: none;
  }
  @media (min-width: 921px) {
    .mcw__side {
      display: block;
    }
  }

  /* ---- Mobile TOC ---- */
  .mcw__toc-m {
    background: var(--nz-subtle-secondary);
    border: 1px solid var(--nz-stroke-card);
    border-radius: var(--nz-radius-large);
  }
  @media (min-width: 921px) {
    .mcw__toc-m {
      display: none;
    }
  }
  .mcw__toc-m > summary {
    cursor: pointer;
    user-select: none;
    list-style: none;
    padding: var(--nz-space-3) var(--nz-space-4);
    font: var(--nz-font-body-strong);
    color: var(--nz-text-primary);
    display: flex;
    align-items: center;
    gap: var(--nz-space-2);
  }
  .mcw__toc-m > summary::-webkit-details-marker {
    display: none;
  }
  .mcw__toc-m > summary::before {
    content: '☰';
    color: var(--nz-text-tertiary);
    font-size: 13px;
  }
  .mcw__toc-m[open] > summary {
    border-bottom: 1px solid var(--nz-stroke-default);
  }
  .mcw__toc-m :global(.wiki-nav) {
    border: none;
    border-radius: 0;
    background: transparent;
    max-height: 60vh;
    overflow-y: auto;
  }

  /* ---- Main column ---- */
  .mcw__main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--nz-space-6);
  }
  /* Vertical rhythm between the page's top-level blocks (cards, grids, lists). */
  .mcw__body {
    display: flex;
    flex-direction: column;
    gap: var(--nz-space-6);
  }
  .mcw__head {
    display: flex;
    flex-direction: column;
    gap: var(--nz-space-2);
  }
  .mcw__title {
    font: var(--nz-font-title-large);
    letter-spacing: -0.02em;
  }
  @media (max-width: 700px) {
    .mcw__title {
      font: var(--nz-font-title);
    }
  }
  .mcw__lead {
    font: var(--nz-font-body-large);
    color: var(--nz-text-secondary);
    max-width: 72ch;
  }

  /* =========================================================================
   * Shared content styles for wiki pages. Pages render inside .mcw__body via
   * the slot, so these must be :global to reach them.
   * ======================================================================= */
  .mcw__body :global(.mcw-card) {
    padding: var(--nz-space-6) var(--nz-space-8);
    display: flex;
    flex-direction: column;
    gap: var(--nz-space-4);
    line-height: 1.7;
  }
  @media (max-width: 700px) {
    .mcw__body :global(.mcw-card) {
      padding: var(--nz-space-5);
    }
  }
  .mcw__body :global(.nz-prose) {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .mcw__body :global(.nz-prose > :first-child) {
    margin-top: 0;
  }
  .mcw__body :global(.nz-prose a:not([target='_blank']))::after {
    content: ' →';
    color: var(--nz-text-tertiary);
  }
  .mcw__body :global(.nz-prose a[target='_blank'])::after {
    content: ' ↗';
    color: var(--nz-text-tertiary);
  }
</style>
