{
  "plugins": ["prettier-plugin-astro"],
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 120,
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "overrides": [
    {
      "files": "*.astro",
      "options": { "parser": "astro", "astroCompressHTML": "html" }
    }
  ]
}
